10 INPUT N
15 Q$="0000"
20 FOR I=1 TO N
30 F=F+LOG(I)/LOG(10)
40 NEXT I
50 DIM A(F/4+1)
60 A(1)=1:L=1:K=1
70 FOR M=1 TO N
100 C=0
105 IF A(K)=0 THEN K=K+1:GOTO 105
110 FOR I=K TO L
120 Y=A(I)*M+C
130 C=INT(Y/10000)
140 A(I)=Y-C*10000
150 NEXT I
160 IF C>0 THEN L=L+1:A(L)=C
170 NEXTM
180 GOSUB 200
190 END
200 PRINT N
