10 CLS
20 PRINT " 2<n<10000"
25 INPUT "N=";N
30 IF N<=2 OR N>=10000 OR INT(N)<>N THEN PRINT"2<n<10000":GOTO 25
40 FOR A=0 TO N:IF SQR(A)<>INT(SQR(A)) THEN 130
50   FOR B=A TO N:IF SQR(B)<>INT(SQR(B)) THEN 120
60     FOR C=B TO N:IF SQR(C)<>INT(SQR(C)) THEN 110
70       FOR D=C TO N:IF SQR(D)<>INT(SQR(D)) THEN 100
95       IF A+B+C+D=N THEN PRINT A;"+";B;"+";C;"+";D;"=";N
100 NEXT D
110 NEXT C
120 NEXT B
130 NEXT A
