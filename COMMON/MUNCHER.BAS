10 REM muncher game (by i. angell)
15 REM scrolling sample program
20 SCREEN 0,1:KEY OFF :WIDTH 40
30 GOSUB 1000
40 WHILE ST%
50 GOSUB 2000
60 WEND
70 END
215 STOP
1000 CLS:SC%=0:ST%=-1:LH%=18
1010 LOCATE 10,5:INPUT "type skill factor 0 to 1000";SK%
1020 CA$=CHR$(201)+CHR$(205)+CHR$(187)
1040 DEF SEG=&HB800:COLOR 1,3
1050 LOCATE 25,1:PRINT STRING$(40,CHR$(219));
1060 FOR I%=1 TO 25
1070 LOCATE 24,40,0:PRINT CHR$(219);CHR$(219);
1080 NEXT I%
1090 POKE 1919,16
1100 LOCATE 11,18:PRINT  CA$;
1110 LOCATE 13,6,0:COLOR 16,7:PRINT "PRESS ANY KEY TO START GAME"
1120 COLOR 0,4
1130 LOCATE 15,18:PRINT CA$;:COLOR 1,3
1140 IF INKEY$="" THEN GOTO 1140
1150 FOR I%=1 TO 14
1160 LOCATE 24,40,0:PRINT CHR$(219);CHR$(219);
1170 NEXT I%
1180 LOCATE 25,16:COLOR 7,1
1190 PRINT "score=";SC%
1200 RETURN
1210 DI%=1+INT(SC%/16)
1230 RETURN
2000 DI%=1+INT(SC%/16)
2010 COLOR 1,3
2020 FOR I%=1 TO 10
2030 LOCATE 24,2+INT(RND*38):PRINT CHR$(3);
2040 NEXT I%
2050 COLOR 0
2060 FOR I%=1 TO DI%
2070 LOCATE 24,2+INT(RND*38):PRINT CHR$(2);
2080 NEXT I%
2090 K$=INKEY$
2100 DEF SEG=0:POKE 1050 , PEEK (1052)
2105 IF LEN(K$)<>2 THEN 2140
2110 KB%=ASC(RIGHT$(K$,1))
2120 IF KB%=75 THEN IF LH%>2 THEN LH%=LH%-1
2130 IF KB%=77 THEN IF LH%<37 THEN LH%=LH%+1
2140 DEF SEG=&HB800
2150 HIT%=SCREEN (2,LH%+1)
2160 LOCATE 24,40,0:COLOR 1
2170 PRINT CHR$(219);CHR$(219);:POKE 1919,16
2180 COLOR 0,4:LOCATE 1,LH%:PRINT CA$;:COLOR 4,3
2190 IF HIT%=3 THEN SC%=SC%+1 : SOUND 220+RND*1000,6:COLOR 4:LOCATE 1,LH%+1:PRINT CHR$(3);
2200 IF HIT%=2 THEN ST%=0:SOUND 4600,2:SOUND 5600,6:SOUND 37,8:COLOR 0:LOCATE 1,LH%+1:PRINT CHR$(2);:COLOR 16,7:LOCATE 13,15:PRINT "game over";
2210 LOCATE 25,16:COLOR 7,1
2220 PRINT "score=";SC%;
2230 FOR I%=1 TO SK%:NEXT I%
2240 RETURN
2250 END
