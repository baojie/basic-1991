140 GOTO 100
300 SCREEN ,,0,0:GOSUB 6000
400 FOR T=1 TO 60:SOUND RND*100+37,RND*3:NEXT T:SOUND 1500,10:SOUND 1200,20
410 Z=Z+1
500 GOTO 56
