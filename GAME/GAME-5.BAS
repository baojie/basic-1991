100 REM *********区位码和机内码**********
110 CLS:LOCATE 4
120 PRINT TAB(15)"1. -打印区位码"
130 PRINT TAB(15)"2. -打印机内码"
140 LOCATE 8,10
150 INPUT "请输入数字选择(1或2)",N
160 IF N<1 OR N>2 THEN 200
170 IF N=1 THEN GOSUB 210
180 IF N=2 THEN GOSUB 370
190 GOTO 110
200 END
210 REM 区位码
220 PRINT TAB(18)"**********区位码************"
230 PRINT:PRINT
280 FOR Q=1 TO 94
290 PRINT
300 FOR W=1 TO 94
310 IF W<10 THEN W$="0"+STR$(W) ELSE W$=STR$(W)
320 IF Q<10 THEN COD$="0"+STR$(Q)+W$ ELSE COD$=STR$(Q)+W$
330 PRINT COD$;"--";CHR$(&HA0+Q)+CHR$(&HA0+W),
340 NEXT W
345 PRINT "  "
350 NEXT Q
360 RETURN
370 REM 机内码
380 PRINT TAB(18)"**********机内码**********"
390 PRINT:PRINT
450 FOR Q=1 TO 94
460 PRINT
470 FOR W=1 TO 94
500 PRINT HEX$(160+Q);HEX$(160+W);"--";CHR$(&HA0+Q)+CHR$(&HA0+W),
510 NEXT W
520 PRINT  "   "
530 NEXT Q
540 RETUPN
