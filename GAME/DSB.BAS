10 REM da shan bing game
15 REM by ye ping (3/15/1986)
20 SCREEN 0,1:WIDTH 80:KEY OFF:COLOR 0,9:CLS
30 LOCATE 8,28:PRINT "game move key:"
40 LOCATE 10,28:PRINT "left-------[4]key"
50 LOCATE 12,28:PRINT "right------[6]key"
60 LOCATE 14,28:PRINT "fire-------[space]key"
70 LOCATE 18,28:INPUT "input number(0--10)";K$:K=VAL(K$)
75 IF K<1 OR K>10 THEN LOCATE 18,28:PRINT SPACE$(25);:GOTO 70
80 CLS
90 T$=RIGHT$(TIME$,2):TT=VAL(T$):RANDOMIZE(TT)
100 COLOR 14:FOR I=1 TO 80:LOCATE 24,I:PRINT CHR$(177);:NEXT I:COLOR 0
110 A$=CHR$(32)+CHR$(17)+CHR$(220)+CHR$(220)+CHR$(16)
115 B$=CHR$(2)
120 FOR I=1 TO 76:LOCATE 2,I:PRINT A$;:IF I/3=INT(I/3) THEN SOUND RND*I+600,4
125 NEXT I:LOCATE 2,77:PRINT " ";
130 DIM X(K),Y(K),Z(K):M=40:G=0
140 FOR I=1 TO K:Y(I)=2
150 X(I)=INT(RND*80)+1
160 IF I=1 THEN 180
170 FOR J=1 TO I-1:IF X(I)=X(J) THEN 150
175 NEXT J
180 LOCATE Y(I),X(I):PRINT ".";:NEXT I
190 COLOR 7:LOCATE 23,M:PRINT B$;:COLOR 0
200 FOR I=1 TO K:IF Z(I)=-1 THEN 245
210 LOCATE Y(I),X(I):PRINT " ";
220 N=INT(RND+K*.1):Y(I)=Y(I)+N
230 IF Y(I)>=24 THEN Y(I)=24:G=G+1:Z(I)=-1:BEEP
240 LOCATE Y(I),X(I):PRINT CHR$(6);
242 FOR T=1 TO 500:NEXT T
245 GOSUB 500
250 NEXT I
260 FOR J=1 TO K:IF Z(J)=0 THEN 200
270 NEXT J
300 LOCATE 5,25:PRINT "********";K-G;"/";K;"********"
310 END
500 K$="":K$=INKEY$
510 IF K$<>"" THEN 600
520 FOR J=1 TO K:IF Z(J)=-1 THEN 550
530 IF X(J)<>M THEN 550
540 COLOR 15,4:LOCATE Y(J),X(J):PRINT "*";:SOUND RND*500+160,5:COLOR 0,9
545 Z(J)=-1 : RETURN
550 NEXT J
560 IF RIGHT$(K$,1)=CHR$(75) AND M>1 THEN LOCATE 23,M:PRINT "";:M=M-1:GOTO 650
600 IF RIGHT$(K$,1)=CHR$(75) AND M>1 THEN LOCATE 23,M:PRINT "";:M=M-1:GOTO 650
610 IF RIGHT$(K$,1)=CHR$(77) AND M<80 THEN LOCATE 23,M:PRINT "" ;:M=M+1:GOTO 650
650 COLOR 7:LOCATE 23,M:PRINT B$;:COLOR 0:RETURN
660 END
