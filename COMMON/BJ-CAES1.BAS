5 CLS:DIM A(30)
10 LOCATE 12,35:INPUT "n=",N
20 FOR I= 1 TO N
30 A=INT (RND(1)*6+1)
40 B=INT(RND(1)*6+1)
50 ON A+B GOSUB 200,300,400,500,600,700,800,900,1000,1100,1200
60 LOCATE 12,35:PRINT A;"+";B;"=";A+B:LOCATE 12,35
70 NEXT I
75 CLS
80 FOR J=2 TO 12
90 PRINT J;"共出现";A(J);"次":LOCATE J-1,20:PRINT"占";A(J)/N*100;"％"
100 NEXT J
150 END
190 DIM A(30)
200  A(2)=A(2)+1:RETURN  2 + 5 = 7
300  A(3)=A(3)+1:RETURN
400  A(4)=A(4)+1:RETURN
500  A(5)=A(5)+1:RETURN
600  A(6)=A(6)+1:RETURN
700  A(7)=A(7)+1:RETURN
800  A(8)=A(8)+1:RETURN
900  A(9)=A(9)+1:RETURN
1000 A(10)=A(10)+1:RETURN
1100 A(11)=A(11)+1:RETURN
1200 A(12)=A(12)+1:RETURN
