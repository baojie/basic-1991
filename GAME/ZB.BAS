10 REM zhui bu game
20 SCREEN 0,1:KEY OFF:DEFINT A-Z
30 COLOR 1,0:WIDTH 40:CLS
35 LOCATE 10,10:INPUT "input speed(1-5)";SP:SP=SP*500+800
38 CLS
40 Y=3
50 READ X:IF X<0 THEN 100
60 READ X1
70 LOCATE Y,X:PRINT CHR$(219);
80 IF X>=X1 THEN 50
90 X=X+1:GOTO 70
100 Y=Y+1 : IF Y<21 THEN 50
110 DATA 8,30,-1,8,8,19,19,30,30,-1,8,8,10,17,19,19,21,28,30,30,-1,8,8,10,17,19,19,21,28,30,30,-1,8,8,19,19,30,30,-1,8,8,10,11,13,25,27,28,30,30,-1
120 DATA 8,8,10,11,27,28,30,30,-1,8,8,13,25,30,30,-1,8,11,13,13,25,25,27,30,-1,11,11,13,13,25,25,27,27,-1,8,11,13,25,27,30,-1,8,8,30,30,-1
130 DATA 8,8,10,11,13,25,27,28,30,30,-1,8,8,30,30,-1,8,8,10,17,19,19,21,28,30,30,-1,8,8,10,17,19,19,21,28,30,30,-1,8,8,19,19,30,30,-1,8,30,-1
200 COLOR 7
210 LOCATE 7,19:PRINT CHR$(15);
220 LOCATE 14,19:PRINT CHR$(1);
230 T=VAL(RIGHT$(TIME$,2)):RANDOMIZE(T)
240 KY=75:PY=14:PX=1:MY=7:MX=19
250 VX=-1:VY=0:Q=0
300 K$=INKEY$
310 DEF SEG=0:POKE 1050,PEEK (1052)
320 IF LEN(K$)<>2 THEN 380
330 KB=ASC(RIGHT$(K$,1))
340 IF KB=72 AND SCREEN (PY-1,PX)<>219 THEN GOSUB 2000:GOTO 380
350 IF KB=80 AND SCREEN (PY+1,PY)<>219 THEN GOSUB 2010 :GOTO 380
360 IF KB=75 AND SCREEN (PY,PY-1)<>219 THEN GOSUB 2020 :GOTO 380
370 IF KB=77 AND SCREEN (PY,PY+1)<>219 THEN GOSUB 2030:GOTO 380
380 LOCATE PY,PX:PRINT CHR$(1);:Q=Q+1:LOCATE 12,18:PRINT Q;
390 S=0:IF SCREEN (MY+VY,MX+VX)<>219 THEN S=1
400 IF SCREEN (MY+VX,MX-VY)<>219 THEN S=S+2
410 IF SCREEN (MY-VX,MX+VY)<>219 THEN S=S+4
415 FOR T=1 TO SP:NEXT T
420 ON S GOSUB 510,610,710,810,910,1010,1110
430 GOTO 300
510 LOCATE MY,MX:PRINT "";:MX=MX+VX:MY=MY+VY
515 IF SCREEN (MY,MX)=1 THEN 9999
520 BEEP:LOCATE MY,MX:PRINT CHR$(15);
530 RETURN
610 ST=VX:VX=-VY:VY=ST:GOTO 510
710 D1=ABS(PX-MX-VX)+ABS(PY-MY-VY)
720 D2=ABS(PX-MX+VY)+ABS(PY-MY-VX)
730 IF D1>D2 THEN 610
740 IF D1<D2 THEN 510
750 IF RND>.5 THEN 510 ELSE 610
810 ST=VX:VX=VY:VY=-ST:GOTO 510
910 D1=ABS(PX-MX-VX)+ABS(PY-MY-VY)
920 D3=ABS(PX-MX-VY)+ABS(PY-MY+VX)
930 IF D1>D3 THEN 810
940 IF D1<D3 THEN 510
950 IF RND>.5 THEN 510 ELSE 810
1010 D2=ABS(PX-MX+VY)+ABS(PY-MY-VX)
1020 D3=ABS(PX-MX-VY)+ABS(PY-MY+VX)
1030 IF D2>D3 THEN 810
1040 IF D2<D3 THEN 610
1050 IF RND>.5 THEN 610 ELSE 810
1110 D1=ABS(PX-MX-VX)+ABS(PY-MY-VY)
1120 D2=ABS(PX-MX+VY)+ABS(PY-MY-VX)
1130 D3=ABS(PX-MX-VY)+ABS(PY-MY+VX)
1140 IF D1<D2 AND D1<D3 THEN 510
1150 IF D2<D1 AND D2<D3 THEN 610
1160 IF D3<D1 AND D3<D2 THEN 810
1170 R=RND:IF R<.33 THEN 510 ELSE IF R>.66 THEN 610 ELSE 810
2000 LOCATE PY,PX:PRINT "";:PY=PY-1:RETURN
2010 LOCATE PY,PX:PRINT "";:PY=PY+1:RETURN
2020 LOCATE PY,PX:PRINT "";:PX=PX-1:RETURN
2030 LOCATE PY,PX:PRINT "";:PX=PX+1:RETURN
9999 SOUND 5000,2:SOUND 5600,6:SOUND 60,4:SOUND 40,8:COLOR 31
10000 LOCATE MY,MX:PRINT CHR$(15);:COLOR 7:END
10010 END
