10 INPUT "1<=n<=9:",N
20 M=N*2+1:X=N:P=0
30 DIM A$(M,M):O=M
40 FOR I=1 TO M
50   FOR J=1 TO M:IF J<>I THEN 110
70     A$(I,J)=RIGHT$(STR$(X),1):A$(I,M-J+1)=RIGHT$(STR$(X),1)
80     IF X=0 THEN P=1
90     IF P=0 THEN X=X-1
100    IF P=1 THEN X=X+1
110  NEXT J
120 NEXT I
130 Z=(N-1)*2+1:Y=2
140 FOR I=N TO 1 STEP -1
150  B$=CHR$(64+I)
160  FOR J=Y TO Y+Z-1
170    A$(J,N-I+1)=B$:A$(N-I+1,J)=B$
180    A$(J,O)=B$:A$(O,J)=B$
190  NEXT J
200  Y=Y+1:Z=Z-2:O=O-1
210 NEXT I
220 FOR I=1 TO M
230   FOR J=1 TO M
240    PRINT A$(I,J);"  ";
250   NEXT J:PRINT:NEXT I
