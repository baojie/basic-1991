10 INPUT "P,Q,C=";P,Q,C
75 PRINT P;"ö";Q;"=";
80 OPTION BASE 1
90 DIM A(C):N=INT(P/Q):N$=STR$(N)
91 IF P>Q THEN P=P-Q ELSE 100
92 GOTO 91
100 FOR I=1 TO C
110   A(I)=INT(P*10/Q)
130 IF P/Q=INT(P/Q) THEN 190 ELSE P=P*10-A(I)*Q
140 NEXT
190 N$=N$+"."
200 PRINT N$;
210 FOR I=1 TO C
220   PRINT USING"#";A(I);
230 NEXT
240 END
