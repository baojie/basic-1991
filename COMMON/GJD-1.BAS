10 INPUT "A$=",A$
20 INPUT "B$=",B$
30 X=LEN(A$):Y=LEN(B$):DIM A(X),B(Y),C(Y+1,X+Y+1)
40 FOR I=1 TO X
50   X$=MID$(A$,X-I+1,1):IF ASC(X$)>57 OR ASC(X$)<48 THEN PRINT "Wrong!":ERASE A,B,C:GOTO 10
55 A(I)=VAL(X$)
60 NEXT I:PRINT
70 FOR I=1 TO Y
80   X$=MID$(B$,Y-I+1,1):IF ASC(X$)>57 OR ASC(X$)<48 THEN PRINT "Wrong!":ERASE A,B,C:GOTO 10
85 B(I)=VAL(X$)
90 NEXT I
100 FOR I=1 TO Y
110   A=I:E=0
120   FOR J=1 TO X
130     C(I,A)=A(J)*B(I)+E:E=INT(C(I,A)/10):C(I,A)=C(I,A) MOD 10
140     A=A+1
150 NEXT J:C(I,A)=E:NEXT I
160 E=0:FOR J=1 TO X+Y
170   FOR I=1 TO Y
180     U=C(I,J)+U+E:E=0
190   NEXT I
191   B=B+1:C(Y+1,B)=U:IF U>9 THEN C(Y+1,B)=U MOD 10:E=INT(U/10)
192 U=0:NEXT J:C(Y+1,B+1)=E
195 IF C(Y+1,X+Y)=0 THEN X=X-1
200 PRINT A$;"*";B$;"=";:FOR I=X+Y TO 1 STEP -1:PRINT RIGHT$(STR$(C(Y+1,I)),1);:NEXT I
