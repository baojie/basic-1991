10 INPUT N
15 IF INT(N)<>N OR N<=0 THEN 10
20 C=0
30 FOR I=1 TO N
40 A=INT(RND(1)*4)
50 B=INT(RND(1)*4)
60 C=INT(RND(1)*4)
70 IF A=1 THEN D=D+1 ELSE E=E+1
80 IF B=1 THEN D=D+1 ELSE E=E+1
90 IF C=1 THEN D=D+1 ELSE E=E+1
100 NEXT I
110 PRINT "face:";D
120 PRINT "back:";N*3-D
130 PRINT "d/n=";D/(3*N)
140 PRINT "(n*3-d)/n=";(N*3-D)/(3*N)
