5 CLS
10 CLEAR
20 SCREEN 0,0,0
30 WIDTH 40
40 KEY OFF
50 CLS
60 RANDOMIZE VAL(MID$(TIME$,4,2)+RIGHT$(TIME$,2))
80 CHAR$=CHR$(219)
90 LOCATE 1,1,0
120 X=INT(40*RND+1):Y=INT(23*RND+1)
130 DX=INT(3*RND-1):DY=INT(3*RND-1)
140 IF DX=0 OR DY=0 THEN 130
150 IF X<1 OR X>40 THEN 120
160 IF Y<1 OR Y>23 THEN 120
165 COLOR INT(RND*16)
170 LOCATE Y,X:PRINT CHAR$;
180 LOCATE Y,41-X:PRINT CHAR$;
190 LOCATE 24-Y,X:PRINT CHAR$;
200 LOCATE 24-Y,41-Y:PRINT CHAR$;
210 X=X+DX:Y=Y+DY
220 GOTO 130
230 END
