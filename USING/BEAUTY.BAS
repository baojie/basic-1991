20 PRINT "女子健美体型电脑咨询"
30 DIM A$(13),A(13),B(13),C$(13),SM$(13)
40 FOR I=1 TO 13
50 READ A$(I)
60 C$(I)="(厘米)"
70 NEXT I
80 C$(2)="(公斤)"
90 FOR I=3 TO 13
100 READ SM$(I)
110 NEXT I
120 PRINT "请按提示键入测量数据(厘米)"
130 FOR I=1 TO 13
140 IF I<3 THEN 160
150 PRINT SM$(I)
160 PRINT A$(I);C$(I);"=";:INPUT A(I)
170 NEXT I
180 X=5*A(13)/(A(1)-A(13)):X=INT(X*100+.5)/100
190 B(2)=(A(1)-100)*.85:B(3)=A(1)/2
200 B(4)=B(3)-20:B(5)=B(3)+4
210 B(6)=B(4)-10:B(7)=B(6)-20
220 B(8)=B(7)-10:B(9)=B(8)-5
230 B(10)=B(6)/2:B(11)=B(7):B(12)=B(3)/2-4
240 B(10)=B(6)/2:B(11)=B(7):B(12)=B(3)/2-4
250 PRINT TAB(20);"女子健美体型电脑咨询";
260 PRINT "(国内女子健美体型标准)"
270 PRINT TAB(1);STRING$(79,"*")
280 PRINT TAB(20);"您的身高";A(1);"(厘米),";
290 PRINT TAB(20);"您的实际体型是:";TAB(45);"您的体型健美表准应是:";
300 PRINT TAB(1);STRING$(27,"*")
310 FOR I=2 TO 12
320 PRINT TAB(1);A$(I);C$(I);TAB(25);A(I);TAB(50);B(I)
330 NEXT I
340 PRINT TAB(1);A$(13);TAB(25);"5:8";TAB(50);"5:";X
350 PRINT STRING$(79,"*")
360 DATA 身高,体重,胸围,腰围,胯围,大腿围,小腿围,足颈围,手颈围,上臂围,颈围,肩宽, 脐高
370 DATA "胸围:从腋下沿胸上方最丰满处测量"
380 DATA "腰围:在正常情况下,腰的最细部位"
390 DATA "胯围:在体前耻骨平行于腾部最大部位"
400 DATA "大腿围:在大腿的最上部位,腾折线以下"
410 DATA "小腿围:在小腿最丰满处"
420 DATA "足颈围:在足颈的最细部位"
430 DATA "手腕围:在手腕的最细部位"
435 DATA "上臂围:在肩关节与肘之间的中部关节"
450 DATA "颈围:在中部颈最细处"
460 DATA "肩宽:两肩峰之间的距离"
470 DATA "脐高:站立时肚脐至地面高"
480 END
