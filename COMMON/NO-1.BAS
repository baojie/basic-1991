10 SCREEN 0,1:KEY OFF:WIDTH 40:CLS
100 A=0:B=0:X=20:Y=12
110 LOCATE 12,20:PRINT "o";:LOCATE 0,0:PRINT "a";
120 GOSUB 200
130 GOSUB 300
140 GOTO 120
200 LOCATE 12,20:PRINT "";
210 K$=INKEY$
220 IF K$="j" AND X>1 THEN X=X-1:GOTO 260
230 IF K$="k" AND X<40 THEN X=X+1:GOTO 260
240 IF K$="i" AND Y>1 THEN Y=Y-1:GOTO 260
250 IF K$="m" AND Y<24 THEN Y=Y+1
260 LOCATE Y,X:PRINT "o";
270 RETURN
300 LOCATE B,A:PRINT "";
310 A=A+SGN(X-A):B=B+SGN(Y-B)
320 LOCATE B,A:PRINT "a";
330 RETURN
340 END
