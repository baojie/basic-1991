100 'pc3-61
110 SCREEN 2: KEY OFF: CLS
120 PI = 3.14159: B = 45
130 FOR PX = 50 TO 450 STEP 100
140 N = N + 2: L = 0
150 FOR PY = 40 TO 350 STEP 100
160 L = L + 1
170 LOCATE 20, 65: PRINT "n="; N; "l="; L
180 FOR A = 0 TO 2 * PI STEP PI / (30 * N)
190 X = B * SIN((N) * A) + PX
200 Y = B * SIN((L + N) * A) + PY
210 IF A = 0 THEN PSET (X, Y / 2): BX = X: BY = Y / 2
220 LINE -(X, Y / 2)
230 NEXT A: LINE -(BX, BY)
240 NEXT PY, PX
250 END

