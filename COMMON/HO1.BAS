100 REM ****高分辨率作图****
110 DIM WG(3),RG(3),VG(3),FY(3)
120 SCREEN 2,0:KEY OFF
130 LINE(100,100)-(106,106),,BF
140 LINE(103,97)-(100,100)
150 LINE(103,97)-(106,100)
160 LINE(203,97)-(200,106)
170 LINE(203,97)-(206,106)
180 LINE(303,97)-(300,100)
190 LINE(303,97)-(306,100)
200 LINE(303,97)-(303,106)
210 GET(100,97)-(106,106),WG
220 GET(200,97)-(206,106),RG
230 GET(300,97)-(306,106),VG
240 CLS:X=300:Y=100:ST$="V":X1=X-3:Y1=Y+1:X2=X+3:Y2=Y+10:N=0
250 GET(X1,Y1)-(X2,Y2),FY:PUT(X1,Y1),VG,XOR
260 ST$="
270 K$=" ":K$=INKEY$:IF K$=" " THEN 270
280 PUT(X1,Y1),FY,PSET
290 KE=LEN(K$)
300 IF KE=1 THEN ST$=K$:GOTO 400
310 K=ASC(RIGHT$(K$,1))
320 IF K=72 AND Y>1 THEN Y=Y-1:GOTO 400
330 IF K=75 AND X>3 THEN X=X-1:GOTO 400
340 IF K=77 AND X<630 THEN X=X+1:GOTO 400
350 IF K=80 AND Y<186 THEN Y=Y+1:GOTO 400
360 IF K=71 AND Y>1 AND X>3 THEN Y=Y-1:X=X-1:GOTO 400
370 IF K=79 AND Y<186 AND X>3 THEN Y=Y+1:X=X-1:GOTO 400
380 IF K=73 AND Y>1 AND X<630 THEN Y=Y-1:X=X+1:GOTO 400
390 IF K=81 AND Y<186 AND X<630 THEN Y=Y+1:X=X+1:GOTO 400
400 X1=X-3:Y1=Y-1:X2=X+3:Y2=Y+10
410 GET(X1,Y1)-(X2,Y2),FY
420 IF ST$="v" OR ST$="V" THEN PUT(X1,Y1),VG,OR:GOTO 270
430 IF ST$="w" OR ST$="W" THEN PUT(X1,Y1),WG,OR:PSET(X,Y):GOTO 270
440 IF ST$="r" OR ST$="R" THEN PUT(X1,Y1),RG,OR:PRESET(X,Y):GOTO 270
450 IF ST$="s" OR ST$="S" THEN 460 ELSE 280
460 LOCATE 1,1:INPUT "Save";FI$:LOCATE 1,1:PRINT SP$
470 DEF SEG=&HB800:BASVE FI$,0,&H4000:ST$="V":GOTO 420
480 IF ST$="e" OR ST$="E" THEN LOCATE 1,1:INPUT "Load";FI$:BLOAD FI$:ST$="V":GOTO 410
500  IF ST$="q" OR ST$="Q" THEN 500 ELSE 510
510  LOCATE 1,1:INPUT "Quit(Y/N)?";YN$:IF YN$="y" OR YN$="Y" THEN END
520  IF ST$="x" OR ST$="X" THEN LOCATE 1,1:PRINT SP$:ST$="V":GOTO 270
530 BEEP:GOTO 270
