20 REM **********************显示较大的字符或汉字*************************
30 KEY OFF
40 CLS
50 SCREEN 1
60 COLOR 1,1
70 INPUT X$:CLS:PRINT  X$
80 FOR X=0 TO 150
90 FOR Y=0 TO 21
100 V=POINT(X,Y)
110 GOSUB 150
120 NEXT
130 NEXT
140 GOTO 140
150 A=2*X:B=4*Y
160 PSET(A,B+100),V
170 PSET(A,B+101),V
180 PSET(A,B+102),V
190 PSET(A,B+103),V
200 PSET(A+1,B+100),V
210 PSET(A+1,B+101),V
220 PSET(A+1,B+102),V
230 PSET(A+1,B+103),V
240 PSET(X,Y),0
250 RETURN
