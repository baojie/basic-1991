10 INPUT "(3<=N<=20)";N
20 IF N<3 OR N>20 THEN "print again!3<=n<=20!"
30 DIM A(N,N)
40 X=INT((N+1)/2)
50 FOR I=1 TO N
60   FOR J=1 TO N
70     IF I=J OR I+J=N+1 THEN A(I,J)=0
80     IF I<X AND J>I AND J<N-I+1 THEN A(I,J)=1
90     IF J<X AND J<I AND J<N-I+1 THEN A(I,J)=2
100    IF I>X AND J<I AND J>N-I+1 THEN A(I,J)=3
110    IF J>X AND J>I AND J>N-I+1 THEN A(I,J)=4
120  NEXT J
130 NEXT I
140 FOR I=1 TO N
150   FOR J=1 TO N
160     PRINT A(I,J);
170   NEXT J
180   PRINT
190 NEXT I
200 END
