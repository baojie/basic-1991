5 RANDOMIZE
10  INPUT "m,n=";M,N:MIN=999
20  IF M<2 OR N<2 AND N>9 THEN PRINT "3<=m,3<=n<=8":GOTO 10
30  DIM A(M,N)
40  FOR I=1 TO M
50     FOR J=1 TO N
60        A(I,J)=INT(RND(1)*(999))+1:PRINT USING"####";A(I,J);
70     NEXT J:PRINT
80  NEXT I
90  FOR I=1 TO M
100    FOR J=1 TO N
110       IF A(I,J)<MIN THEN MIN=A(I,J):F=J
120    NEXT J
130    MAX=0
140    FOR K=1 TO M
150        IF A(K,F)>MAX THEN MAX=A(K,F):E=K
160    NEXT K
170    IF MAX=MIN THEN PRINT "a(";E;",";F;")" ELSE MIN=999:A=A+1
180 NEXT I
190 IF A=M THEN PRINT "wu jian"
200 END
