10 REM ******键控作图********
20 CLS:KEY OFF
30 SCREEN 2
40 PRINT TAB(2);"利用本程序可以完成键控作图,所画的图形作为文件放在磁盘上,"
50 PRINT TAB(10);"可以在必要时调出显示."
60 PRINT TAB(15);"(1)键控作图;"
70 PRINT TAB(15);"(2)调出显示;"
80 PRINT TAB(15);"(3)退出."
90 LOCATE 9,10
100 PRINT "请输入数字选择......."
110 INPUT A
120 IF A<1 OR A>3 THEN 90
130 ON A GOSUB 180,450,150
140 GOTO 20
150 REM *******************
160 CLS:LOCATE 5,10:PRINT "程序结束,再见!"
170 END
180 REM ******************
190 CLS:KEY OFF
200 LOCATE 3,5
210 LOCATE 5,5:PRINT "图形画完后,按"P"键存盘"
220 LOCATE 6,5:INPUT "     请输入存盘图形的文件名:",F$
230 CLS
240 LINE (0,0)-(639,0):LINE(0,0)-(0,199)
250 LINE (639,0)-(639,199):LINE(639,199)-(0,199)
260 X0=320:Y0=100:C1=C
270 WRITE #1,X,Y,C1
280 X$=INKEY$:IF K$=" " THEN 280
290 IF X$="p" OR X$="P" THEN WRITE #1,X1,Y1,C:CLOSE:RETURN
300 IF X$=" " THEN IF C=1 THEN C=0 ELSE C=1
310 IF X$="i" OR X$="I" THEN Y1=Y1-2
320 IF X$="j" OR X$="J" THEN X1=X1-5
330 IF X$="k" OR X$="K" THEN Y1=Y1+2
340 IF X$="l" OR X$="L" THEN X1=X1+5
350 IF X$="q" OR X$="Q" THEN X1=X1-5:Y1=Y1-3
360 IF X$="a" OR X$="A" THEN X1=X1-5:Y1=Y1+3
370 IF X$="w" OR X$="W" THEN X1=X1+5:Y1=Y1-3
380 IF X$="s" OR X$="S" THEN X1=X1+5:Y1=Y1+3
390 IF X$<>XX$ THEN WRITE #1,X,Y,C1:WRITE #1 ,X,Y,C
400 XX$=X$:X=X1:Y=Y1:C1=C
410 LINE(X0,Y0)-(X1,Y1),C
420 IF C=0 THEN PSET(X1,Y1)
430 X0=X1:YO=Y1
440 GOTO 280
450 REM ******************
460 CL:KEY OFF
470 LOCATE 5,10:INPUT "请输入需显示图形的文件名:",FI$
480 CLS:SCREEN 2
490 LINE(0!)-(639,0):LINE(0,0)-(0,194)
500 LINE(639,0)-(639,194):LINE(639,194)-(0,194)
510 X0=320:Y0=100:X1=320:Y1=100
520 PSET(X0,Y0)
530 OPEN FI$ FOR INPUT AS #1
540 IF EOF(1)=-1 THEN 610 ELSE INPUT #1,X,Y,C1
550 IF C1=0 THEN X0=X:Y0=Y:GOTO 540
560 IF C=0 THEN X0=X:Y0=Y:C=C1
570 LINE(X0,Y0)-(X1,Y1),C1
580 IF C1=0 PSET(X,Y)
590 X0=X:Y0=Y
600 GOTO 540
610 CLOSE #1
620 LOCATE 25,5:PRINT "按任意键继续........."
630 R$=INKEY$:IF R$=" " THEN 610
640 RETURN
