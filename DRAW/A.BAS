10 REM
20 CLS
30 SCREEN 1
40 DIM A(150)
50 COLOR  8,0
60 CIRCLE(160,100),10,2
70 PAINT(160,100),2,2
80 GET(150,90)-(170,110),A
90 CLS
100 LINE(19,50)-(299,77),,B
110 LINE(20,51)-(300,78),,B
120 LINE(233,53)-(253,75),3,BF
130 LINE(191,53)-(222,75),2,BF
140 LINE(160,53)-(190,75),1,BF
150 FOR D=0 TO 1
160 COLOR 8,D
170 S=20+D*260
180 E=280-D*260
190 Y=57
200 Y2=Y
210 FOR X=S TO E STEP 4-8*D
220 FOR  T=1 TO 90:NEXT T
230 IF F=1 THEN PUT(X2,Y2),A
240 PUT(X,Y),A
250 X2=X
260 F=1
270 NEXT
280 NEXT
290 GOTO 150
