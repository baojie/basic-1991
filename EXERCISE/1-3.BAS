6 PRINT "(1<n<10)"
10 INPUT N
17 IF N<=1 OR N>=10 OR INT(N)<>N OR ABS(N)<>N THEN PRINT "(1<n<10),again input!":GOTO 10
20 OPTION BASE 1
30 DIM A(N,N)
50 IF J=1  THEN A(I,1)=I
55 IF I=N THEN A(N,J)=N+J-1
56 IF J=2 THEN A(I,J)=I+10
60 J=1:X=1:Y=1:U=N
70 FOR I=1 TO U
80   A(X,Y)=J:X=X+1:J=J+1
100 NEXT
105 X=X-1:Y=Y+1
110 FOR I=1 TO U-1
120   A(X,Y)=J:Y=Y+1:J=J+1
140 NEXT
145 X=X-1:Y=Y-2
150 FOR I=1 TO U-2
160   A(X,Y)=J:X=X-1:Y=Y-1:J=J+1
180 NEXT
190 IF U<4 THEN 200 ELSE X=X+2:Y=Y+1:U=U-3:GOTO 70
200 FOR I=1 TO N
210 FOR J=1 TO I
220 PRINT USING"###";A(I,J);
230 NEXT J
235 PRINT
240 NEXT I
250 END
