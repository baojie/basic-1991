20 OPTION BASE 1
30 DIM A(100)
40 A(1)=1
50 FOR I=2 TO 100
60 M=A(I-1)
62 FOR J=2 TO 100
64 IF A(J)=0 THEN A(J)=M*3+1:J=100:NEXT
66 FOR J=2 TO 100
67 IF A(J)=0 THEN A(J)=M*4+1:J=100
68 NEXT:NEXT
90 A(1)=1
100 FOR I=2 TO 100:FOR J=I+1 TO 100
110   IF A(I)>A(J) THEN SWAP A(I),A(J)
120 NEXT:NEXT
130 FOR I=1 TO 100
140   PRINT A(I);
150 NEXT
160 END
