10 SCREEN 1
20 KEY OFF:CLS
30 INPUT "A1(3~60)=",A1:A=A1
40 INPUT "B1(3~60)=",B1:B=B1
50 INPUT "K1(3~60)=",K1:K=K1
60 INPUT "N1=",N1:N=N1
70 GOSUB 90
80 END
90 CLS
100 X0=140:Y0=80:PI=3.1415926#
110 C=A-B
120 FOR I=0 TO N*360 STEP 2.5
130 T=PI*I/180:D=C*T/B
140 X=X0+INT(C*COS(T)+K*COS(D))
150 Y=Y0+INT(C*SIN(T)+K*SIN(D))
160 PSET(X,Y),3
170 NEXT I
180 RETURN
