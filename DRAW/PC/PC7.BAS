100 'pc3-53
110 SCREEN 2:KEY OFF:CLS
120 X0=120:X1=180:Y1=180
130 A=Y1/(X1*(X1-X0)*(X1+X0))
140 FOR YY=-75 TO 75 STEP 75
150 FOR XX=-50 TO 50 STEP 5
160 FOR X=-180 TO 180 STEP 2
170 Y=A*X*(X-X0)*(X+X0)
180 PX=320+X+XX:PY=100-Y/2 +YY/2
190 IF X=-180 THEN PSET(PX,PY)
200 LINE-(PX,PY)
210 NEXT X
220 NEXT XX
230 NEXT YY
